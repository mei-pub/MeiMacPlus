<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The vendored Hammerspoon runtime loads hs.* modules as separate
	     dylibs (Contents/Frameworks/hs/*.dylib) via Lua's package.cpath.
	     Library validation would refuse them under hardened runtime unless
	     they share the host's signing identity, which ad-hoc/CI builds
	     cannot guarantee. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
