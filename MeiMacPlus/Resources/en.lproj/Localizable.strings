/* Keep awake */
"settings.section.keepAwake" = "Keep Awake";
"settings.keepAwake" = "Keep the screen on; closing the lid only blanks the display (no sleep, no network loss)";
"settings.keepAwake.footer" = "While on: an open lid never blanks the screen, and closing the lid only turns the display off — the system stays awake, network and apps keep running, and reopening the lid resumes instantly. Note: macOS 26.2 has a system-level fault in its lock-password write path (neither System Settings nor the CLI can change it), so reopening the lid still asks for a password; this resolves automatically once macOS fixes it, and MeiMacPlus keeps retrying so it kicks in when possible. An administrator password is asked once for the first enable and for some toggles (helper install). The Mac won't sleep automatically or manually while enabled — mind heat on battery; other keep-awake tools (e.g. Awayke) will fight over the same setting.";
"keepawake.error.title" = "Could not change a keep-awake setting";
"keepawake.error.body" = "An error occurred: %@";
"keepawake.healed.title" = "Keep Awake · wake without password active";
"keepawake.healed.body" = "macOS fixed the lock-settings channel — reopening the lid no longer asks for a password.";

